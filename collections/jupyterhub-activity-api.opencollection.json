{
  "opencollection": "1.0.0",
  "info": {
    "name": "JupyterHub REST Activity API",
    "version": "5.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activity",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JupyterHub Notify user activity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8000/hub/api/users/:name/activity",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Notifies the Hub of activity for the named user. Used by single-user servers to extend their lifetime."
        }
      ]
    }
  ],
  "bundled": true
}