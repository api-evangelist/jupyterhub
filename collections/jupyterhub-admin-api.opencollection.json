{
  "opencollection": "1.0.0",
  "info": {
    "name": "JupyterHub REST Activity Admin API",
    "version": "5.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JupyterHub Shutdown",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8000/hub/api/shutdown"
          },
          "docs": "Shuts down the Hub."
        }
      ]
    }
  ],
  "bundled": true
}